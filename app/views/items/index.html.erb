<table>  
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Expected cost</th>
            <th>Is done?</th>
        </tr>
    </thead>
    <tbody>
        <% @items.each do |item| %>
            <tr>
                <th><%= item.id %></th>
                <th><%= item.title %></th>
                <th><%= item.expected_cost %></th>
                <th><%= item.is_done %></th>
            </tr>
        <% end %>
    </tbody>
</table>