<table>  
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Body</th>
        </tr>
    </thead>
    <tbody>
        <% @notes.each do |note| %>
            <tr>
                <th><%= note.id %></th>
                <th><%= note.name %></th>
                <th><%= note.body %></th>
            </tr>
        <% end %>
    </tbody>
</table>